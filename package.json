{
  "name": "sigil",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Error bars for LLM-as-judge evals: calibration (ECE/Brier/reliability), finite-sample risk certificates (Clopper-Pearson, Learn-Then-Test), Pass^k reliability, anytime-valid drift monitoring, and a cost-at-equal-quality frontier gated by an exact McNemar test. Dependency-free TypeScript; the analysis path calls no model, holds no key, and opens no socket.",
  "author": "Aditya Prathapa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apatureai/sigil.git"
  },
  "homepage": "https://github.com/apatureai/sigil#readme",
  "bugs": {
    "url": "https://github.com/apatureai/sigil/issues"
  },
  "keywords": [
    "llm-as-judge",
    "calibration",
    "conformal-prediction",
    "e-process",
    "model-risk",
    "eval"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
